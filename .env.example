# No hosted AI provider is required.
# Future local model/checkpoint configuration will live here.

# Optional live research provider. Leave empty to disable live research.
# The endpoint should accept ?q=<query>&limit=<n> and return
# {"results":[{"title":"...","url":"...","snippet":"..."}]}.
INDOONE_RESEARCH_URL=
INDOONE_RESEARCH_TOKEN=
INDOONE_RESEARCH_TIMEOUT=10

# Google Workspace OAuth (used by Gmail, Calendar and Google Drive integrations).
INDOONE_GOOGLE_CLIENT_ID=
INDOONE_GOOGLE_CLIENT_SECRET=

# Fernet key used to encrypt user-scoped OAuth access/refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INDOONE_OAUTH_ENCRYPTION_KEY=

# Telegram Bot API. Create the bot with @BotFather and keep this secret server-side.
INDOONE_TELEGRAM_BOT_TOKEN=
# Optional secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token webhook header.
INDOONE_TELEGRAM_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API credentials.
INDOONE_WHATSAPP_ACCESS_TOKEN=
INDOONE_WHATSAPP_PHONE_NUMBER_ID=
INDOONE_WHATSAPP_VERIFY_TOKEN=
INDOONE_WHATSAPP_APP_SECRET=

# YouTube Data API.
# Search/public lookups use an API key; private channel access and uploads use Google OAuth.
INDOONE_YOUTUBE_API_KEY=

# Instagram Business Login for professional (Business/Creator) accounts.
INDOONE_INSTAGRAM_APP_ID=
INDOONE_INSTAGRAM_APP_SECRET=

# Facebook Login for Pages.
INDOONE_FACEBOOK_APP_ID=
INDOONE_FACEBOOK_APP_SECRET=

# Google Photos uses the same Google OAuth client credentials above.

{
  "schema_version": 1,
  "training_policy": {
    "trigger_on_backend_ai_change": true,
    "trigger_on_api_change": true,
    "trigger_on_dataset_change": true,
    "require_dataset_audit": true,
    "require_behavioral_gate": true,
    "require_candidate_evaluation": true,
    "auto_publish_candidate": true,
    "auto_promote_only_on_gate": true
  },
  "feature_contract": {
    "description": "Every user-facing AI capability should have a training/evaluation example before it can become a learned model behaviour.",
    "required_fields": [
      "feature_id",
      "category",
      "training_examples",
      "evaluation_cases"
    ],
    "categories": [
      "instruction_following",
      "honesty",
      "safety",
      "grounding",
      "research",
      "conversation",
      "reasoning",
      "multilingual",
      "tool_use",
      "files",
      "vision",
      "email_safety",
      "email_actions"
    ]
  },
  "training_defaults": {
    "steps": 8000,
    "batch_size": 16,
    "checkpoint_interval": 500,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "seed": 42,
    "instruction_mix_ratio": 0.8,
    "instruction_sampling": {
      "curated": 0.9,
      "generated_multilingual": 0.05,
      "capability": 0.05
    }
  },
  "incremental_capabilities": {
    "email_safety": {
      "stable_model_version": "v1",
      "training_mode": "incremental_sft",
      "max_runtime_seconds": 3600,
      "training_budget_seconds": 3300,
      "primary_data": "data/raw/indoone_email_safety_examples.jsonl",
      "validation_data": "data/eval/email_safety_validation.jsonl",
      "test_data": "data/eval/email_safety_test.jsonl",
      "action_data": "data/raw/indoone_email_actions_examples.jsonl",
      "anchor_data": "data/raw/core_instruction_seed.jsonl",
      "production_object_prefix": "models/indoone-small",
      "production_release_repo": "indooneteam/Indoone-Model",
      "production_release_tag": "indoone-model-v1",
      "keep_previous_checkpoint_for_rollback": true
    }
  }
}

# Local Indoone inference remains the default.
# Set INDOONE_MODEL_BACKEND=gemini to use Google AI Studio/Gemini for chat.
INDOONE_MODEL_BACKEND=local

# Server-side Google AI Studio key used by Gemini chat and optionally Indoone Vibe.
# Required only when INDOONE_MODEL_BACKEND=gemini or Gemini Live is enabled.
GEMINI_API_KEY=
# This Gemma 4 model supports the model-selected free search_web tool.
GEMINI_MODEL=gemma-4-26b-a4b-it
# Optional: the model that chooses and drives tools. Point it at a different
# model than GEMINI_MODEL so a message and its tool calls draw on two separate
# provider quotas; when unset the tool loop uses GEMINI_MODEL.
GEMINI_TOOL_MODEL=gemma-4-26b-a4b-it
GEMINI_TIMEOUT_SECONDS=60
# Base URL for the Generative Language API. Override only for a proxy or region.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Leave maxOutputTokens unset to use the selected model's output-token limit.

# Runtime environment: use "production" in deployed production services.
INDOONE_ENV=development

# Signed bearer authentication. Production must use a strong random secret (32+ chars)
# and INDOONE_AUTH_REQUIRED=true.
INDOONE_AUTH_SECRET=
# Set true to require bearer authentication globally; protected routes enforce auth independently.
INDOONE_AUTH_REQUIRED=false
# Set true to require authentication for connector endpoints even when global auth is optional.
INDOONE_CONNECTOR_AUTH_REQUIRED=true
# Firebase project id used to verify Firebase ID tokens. Defaults to "indoone".
FIREBASE_PROJECT_ID=indoone
# Server-side HMAC secret for tool approval tokens. Keep separate from the auth secret.
INDOONE_APPROVAL_SECRET=

# Network trust boundaries. Production must explicitly set the allowed hostnames.
INDOONE_ALLOWED_HOSTS=
# Extra browser origins, comma separated. The project's own web app,
# https://indooneteam.github.io, is always allowed in addition to these.
INDOONE_ALLOWED_ORIGINS=
# Trust forwarded client/scheme/host headers only when behind a known reverse proxy.
INDOONE_TRUST_PROXY_HEADERS=false
# Comma-separated IPs/CIDRs for trusted reverse proxies when proxy headers are enabled.
INDOONE_TRUSTED_PROXY_IPS=

# Tavily general web search. Keep the key server-side; never expose it to Android/client code.
# When configured, Tavily becomes the primary general web-search provider.
# Basic search is used by default to control API-credit usage.
INDOONE_TAVILY_API_KEY=

# Local Indoone model generation. No hosted LLM API key is required for answer generation.
# Runtime model artifacts are served only from the private Indoone-Model GitHub Release.
GITHUB_MODEL_REPOSITORY=indooneteam/Indoone-Model
GITHUB_MODEL_RELEASE_TAG=indoone-model-v1
GITHUB_MODEL_TOKEN=
# Allow CPU-only training in CI/hosted runs (Colab GPU is the normal path).
INDOONE_ALLOW_CPU_TRAINING=false

# Optional custom live research provider. When empty, Indoone uses the built-in
# Google News RSS research provider for current/research requests.
# A custom endpoint should accept ?q=<query>&limit=<n> and return
# {"results":[{"title":"...","url":"...","snippet":"..."}]}.
# Production uses HTTPS and does not allow credentials embedded in the URL.
INDOONE_RESEARCH_URL=
INDOONE_RESEARCH_TOKEN=
INDOONE_RESEARCH_TIMEOUT=10
# User-Agent sent to Wikimedia/public sources; keep it descriptive.
INDOONE_WIKIMEDIA_USER_AGENT=

# Global HTTP request body limit. The backend clamps this to 100 MiB.
INDOONE_MAX_REQUEST_BYTES=52428800

# SQLite capability-store path and runtime defaults.
INDOONE_CAPABILITY_DB=data/indoone_capabilities.db
# SQLite path for chat conversation history.
INDOONE_CONVERSATION_DB=data/indoone_conversations.sqlite3
# Directory where uploaded media is stored.
INDOONE_MEDIA_DIR=data/media
# SQLite path for registered device push tokens (notification registration).
INDOONE_NOTIFICATION_DB=data/indoone_notifications.db
INDOONE_SQLITE_BUSY_TIMEOUT_MS=5000

# Google Workspace OAuth (used by Gmail, Calendar and Google Drive integrations).
INDOONE_GOOGLE_CLIENT_ID=
INDOONE_GOOGLE_CLIENT_SECRET=

# GitHub OAuth App for the Android GitHub plugin. Register this callback URL
# in the GitHub OAuth App settings (replace YOUR_BACKEND_HOST with the deployed API host).
# Callback: https://YOUR_BACKEND_HOST/api/integrations/github/callback
INDOONE_GITHUB_CLIENT_ID=
INDOONE_GITHUB_CLIENT_SECRET=

# Zoho Mail OAuth: keep the client secret on the backend only.
INDOONE_ZOHO_CLIENT_ID=
INDOONE_ZOHO_CLIENT_SECRET=
# Must exactly match the callback URI registered in the Zoho API Console.
INDOONE_ZOHO_REDIRECT_URI=https://YOUR_BACKEND_HOST/api/integrations/zoho-mail/callback
# Both values must match the Zoho account's data center (India defaults shown).
INDOONE_ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
INDOONE_ZOHO_MAIL_API_BASE_URL=https://mail.zoho.in/api
INDOONE_ZOHO_SCOPE=ZohoMail.accounts.READ,ZohoMail.folders.READ,ZohoMail.messages.READ,ZohoMail.messages.CREATE,ZohoMail.messages.DELETE

# Fernet key used to encrypt user-scoped OAuth access/refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When configured in production, the key must be a valid Fernet key.
INDOONE_OAUTH_ENCRYPTION_KEY=

# Telegram Bot API. Create the bot with @BotFather and keep this secret server-side.
INDOONE_TELEGRAM_BOT_TOKEN=
# Optional secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token webhook header.
INDOONE_TELEGRAM_WEBHOOK_SECRET=
# Set true to let the Telegram bot generate AI replies.
INDOONE_TELEGRAM_AI_REPLY_ENABLED=false

# Meta WhatsApp Cloud API credentials.
INDOONE_WHATSAPP_ACCESS_TOKEN=
INDOONE_WHATSAPP_PHONE_NUMBER_ID=
# Secret used by Meta webhook verification (GET) and signature validation (POST).
INDOONE_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
INDOONE_WHATSAPP_APP_SECRET=
# Meta Graph API version used for WhatsApp calls.
INDOONE_WHATSAPP_GRAPH_VERSION=v23.0

# YouTube Data API.
# Search/public lookups use an API key; private channel access and uploads use Google OAuth.
INDOONE_YOUTUBE_API_KEY=

# Instagram Business Login for professional (Business/Creator) accounts.
INDOONE_INSTAGRAM_APP_ID=
INDOONE_INSTAGRAM_APP_SECRET=
# Instagram professional account id used for AI replies.
INDOONE_INSTAGRAM_ACCOUNT_ID=
# Secret used by Instagram webhook verification.
INDOONE_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Facebook Login for Pages.
INDOONE_FACEBOOK_APP_ID=
INDOONE_FACEBOOK_APP_SECRET=

# Google Photos uses the same Google OAuth client credentials above.

# Canva Connect API (OAuth 2.0 + PKCE).
INDOONE_CANVA_CLIENT_ID=
INDOONE_CANVA_CLIENT_SECRET=

# Production server/runtime. PORT is honored by common deployment platforms.
PORT=8000
INDOONE_SERVER_HOST=0.0.0.0
INDOONE_SERVER_PORT=8000
INDOONE_SERVER_WORKERS=1
INDOONE_SERVER_RELOAD=false
INDOONE_SERVER_LIMIT_CONCURRENCY=200
INDOONE_SERVER_TIMEOUT_KEEP_ALIVE=5
INDOONE_SERVER_TIMEOUT_GRACEFUL_SHUTDOWN=30
INDOONE_SERVER_LOG_LEVEL=info

# Optional image-generation provider (a local/self-hosted endpoint).
INDOONE_IMAGE_GENERATOR_URL=
INDOONE_IMAGE_GENERATOR_TOKEN=
INDOONE_IMAGE_GENERATOR_TIMEOUT=120

# Slack connector (OAuth app client id).
INDOONE_SLACK_CLIENT_ID=

# Voice capture timeout in seconds.
INDOONE_VOICE_TIMEOUT=120

# Keep real .env files out of git and store production secrets in the deployment secret manager.

# Optional Google Gemini Live API for Indoone Vibe real-time voice.
# It uses the same server-side GEMINI_API_KEY defined above.
# Use the Extended Thinking audio model; regular text-chat model settings are separate.
GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
GEMINI_LIVE_THINKING_LEVEL=low
GEMINI_LIVE_VOICE=Aoede

.venv/
__pycache__/
.pytest_cache/
*.pyc
data/processed/

# Local environment files can contain production credentials. Keep only the template tracked.
.env
.env.*
!.env.example

# The trained Indoone runtime artifacts are intentionally tracked in this deployment
# so Render can load the model locally without downloading it from object storage.
# Keep the checkpoint and tokenizer below GitHub's 100 MB per-file hard limit.

# Runtime SQLite databases and their live WAL sidecar files are local server state.
data/indoone_capabilities.db
data/indoone_capabilities.db-*
data/indoone_conversations.sqlite3
data/indoone_conversations.sqlite3-*
